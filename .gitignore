# Byte-compiled
__pycache__/
*.py[cod]

# Staging area used when RESULTS_DIR is a remote URI
.stage/
.smoke/

# Launcher scratch
runner/logs/
runner/hosts.txt

# Derived outputs: regenerated by scripts/collect.sh from results/
derived/

# LaTeX build products
paper/*.aux
paper/*.log
paper/*.out
paper/*.blg
paper/*.bbl
paper/*.fdb_latexmk
paper/*.fls
paper/*.synctex.gz

# OS noise
.DS_Store

# Model weights and datasets are downloaded, never committed
*.safetensors
*.bin
!data/*.parquet

# Local research artifacts and manuscript materials
/analysis/
/FINDINGS.md
/logs/
/paper/
/results/
/results_smoke/
/derived/
/scripts/verify.py
/CITATION.cff
